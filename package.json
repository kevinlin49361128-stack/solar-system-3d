{
  "name": "solar-system-3d",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "og:capture": "node scripts/og-capture.mjs",
    "screenshots": "node scripts/readme-screenshots.mjs",
    "lockfile:regen": "rm -rf node_modules package-lock.json && npx -y npm@10.9.2 install --no-audit --no-fund",
    "hyg:fetch": "mkdir -p tmp_hyg && curl -L -o tmp_hyg/hyg.csv https://raw.githubusercontent.com/astronexus/HYG-Database/main/hyg/CURRENT/hygdata_v41.csv",
    "hyg:build": "node scripts/build-hyg-3d.mjs",
    "hyg:build:deep": "node scripts/build-hyg-3d.mjs --mag 9 --out public/stars-hyg-3d-deep.json",
    "textures:webp": "node scripts/textures-to-webp.mjs"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "satellite.js": "^6.0.2",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "puppeteer-core": "^23.11.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
